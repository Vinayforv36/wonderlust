<% layout('/layouts/boilerplate.ejs') %>

<section class="listing-form-page">
    <header class="form-page-header">
        <p class="form-eyebrow">Keep your space up to date</p>
        <h1>Edit listing</h1>
        <p>Update the details travelers see about your place.</p>
    </header>

    <form class="listing-form" method="POST" action="/listings/<%= Listing._id %>/edit?_method=PUT">
        <div class="form-field">
            <label for="title">Listing title</label>
            <input class="form-control" type="text" id="title" name="title" required placeholder="Listing title" value="<%= Listing.title %>">
        </div>

        <div class="form-field">
            <label for="description">Description</label>
            <textarea class="form-control" id="description" name="description" rows="5" required placeholder="Describe your place"><%= Listing.description %></textarea>
        </div>

        <div class="form-field">
            <label for="image">Image URL <span>(optional)</span></label>
            <input class="form-control" type="url" id="image" name="image" placeholder="https://example.com/photo.jpg" value="<%= Listing.image %>">
        </div>

        <div class="form-field">
            <label for="price">Price per night (₹)</label>
            <input class="form-control" type="number" id="price" name="price" min="0" required placeholder="Price" value="<%= Listing.price %>">
        </div>

        <div class="form-row">
            <div class="form-field">
                <label for="location">Location</label>
                <input class="form-control" type="text" id="location" name="location" required placeholder="City or area" value="<%= Listing.location %>">
            </div>
            <div class="form-field">
                <label for="country">Country</label>
                <input class="form-control" type="text" id="country" name="country" required placeholder="Country" value="<%= Listing.country %>">
            </div>
        </div>

        <button class="primary-action" type="submit">Save changes</button>
    </form>
</section>
